rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads only under applications/{referenceNumber}/...
    match /applications/{ref}/{allPaths=**} {
      allow write: if ref.matches('BE-[0-9]{8}-[0-9]{4}')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      allow read: if false;
    }
  }
}
